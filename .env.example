# Copy this file to `.env.local` and fill in the values. Never commit `.env*` files.
#
# Leave the Supabase values empty to run uwatch in DEMO MODE (local data,
# built-in catalog, simulated sign-in).
#
# Variables prefixed with VITE_ are bundled into the browser build: they must be PUBLIC values only.

# --- Supabase ---
# Project URL and *publishable* key (sb_publishable_...). Never put the secret key (sb_secret_...) here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- TMDB ---
# SERVER-ONLY secret ("API Read Access Token"), read by the /api/tmdb proxy.
# Must NEVER be prefixed with VITE_.
TMDB_READ_ACCESS_TOKEN=
